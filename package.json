{
  "name": "meeting-cue",
  "version": "1.0.1",
  "description": "Private AI meeting cue for stakeholder calls — excluded from screen share on Windows and macOS",
  "main": "dist-electron/main.js",
  "author": "Final Year Project",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/patch-electron-macos-plist.cjs && vite",
    "postinstall": "node scripts/patch-electron-macos-plist.cjs",
    "ensure:codesign": "node build/ensure-codesign-identity.cjs",
    "build": "vite build",
    "dist": "vite build && electron-builder --mac --win",
    "dist:mac": "vite build && electron-builder --mac dmg zip",
    "dist:win": "vite build && electron-builder --win nsis portable",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.finalyear.meetingcue",
    "productName": "Meeting Cue",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "afterPack": "./build/afterPack.cjs",
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Meeting Cue needs the microphone to capture your voice during calls.",
        "NSScreenCaptureUsageDescription": "Meeting Cue needs Screen Recording to hear system / meeting audio and capture on-screen questions.",
        "NSAudioCaptureUsageDescription": "Meeting Cue needs system audio access to transcribe the other person on the call (macOS 14.2+).",
        "CFBundleDisplayName": "Meeting Cue"
      }
    },
    "dmg": {
      "title": "Meeting Cue",
      "contents": [
        {
          "x": 140,
          "y": 180,
          "type": "file"
        },
        {
          "x": 420,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Meeting Cue"
    }
  },
  "dependencies": {
    "electron-audio-loopback": "^1.0.6",
    "electron-store": "^8.2.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.2",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
